{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:jest/recommended"
  ],
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false,
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module",
    "babelOptions": {
      "plugins": ["@babel/plugin-syntax-jsx"]
    }
  },
  "plugins": ["react", "jest"],
  "rules": {
    "react/prop-types": "off",
    // Tests run on Vitest, whose API is Jest compatible, so the jest plugin's
    // rules mostly apply.
    // This one is the exception and needs to be disabled.
    "jest/no-deprecated-functions": "off",
    "jest/no-disabled-tests": "warn",
    "jest/no-focused-tests": "error",
    "jest/no-identical-title": "error",
    "jest/prefer-to-have-length": "warn",
    "jest/valid-expect": "error",
    "react/no-unescaped-entities": 0
  },
  "settings": {
    "react": {
      "version": "detect",
      "flowVersion": "0.53" // Flow version
    }
  },
  "globals": {
    "process": true,
    // Vitest exposes these as globals (test.globals in vite.config.js). The jest
    // plugin's env covers the shared ones like describe/test/expect, but not the
    // Vitest-only additions below.
    "vi": true,
    "vitest": true,
    "suite": true,
    "assertType": true,
    "expectTypeOf": true,
    "onTestFinished": true,
    "onTestFailed": true
  }
}
